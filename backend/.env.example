# Database configuration
MONGO_URI=mongodb://localhost:27017/your-exchange-db

# Market Data Configuration
# Set to 'true' if experiencing Binance 451 errors (geographical restrictions)
BINANCE_BLOCKED=false
# Alternative market data sources priority (comma-separated): binance,coingecko,coinbase,kraken
MARKET_DATA_SOURCES=binance,coingecko,coinbase
# Enable debug logging for market data connections
MARKET_DATA_DEBUG=falseDatabase Configuration
MONGO_URI=mongodb://localhost:27017/your-exchange-db

# JWT Secrets
JWT_SECRET_USER=your-super-secret-jwt-key-for-users
JWT_SECRET_ADMIN=your-super-secret-jwt-key-for-admins

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN_DEV=http://localhost:5174
CORS_ORIGIN_PROD=https://nexabitexchange.pro

# Frontend URLs
FRONTEND_URL=https://nexabitexchange.pro
FRONTEND_URL_PROD=https://nexabitexchange.pro

# Server Configuration
PORT=5001
NODE_ENV=development

# HD Wallet Configuration
MASTER_SEED=your-24-word-mnemonic-phrase-here
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Blockchain RPC URLs
BSC_RPC_URL=https://bsc-dataseed1.binance.org:443

# API Keys for Blockchain Explorers
BSCSCAN_API_KEY=your-bscscan-api-key

# Deposit Monitoring
DEPOSIT_CHECK_INTERVAL=30000

# Master Wallet Addresses (for sweeping funds)
MASTER_WALLET_BEP20=0x1234567890123456789012345678901234567890
MASTER_WALLET_PRIVATE_KEY=your-master-wallet-private-key-here

# Deposit Monitoring
DEPOSIT_CHECK_INTERVAL=30000
AUTO_START_DEPOSIT_MONITORING=true

# Security Settings
BCRYPT_ROUNDS=12
SESSION_TIMEOUT=7d

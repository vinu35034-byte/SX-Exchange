VITE_API_URL=https://nexabitexchange.pro/api/v1

VITE_API_BASE_URL=https://nexabitexchange.pro

VITE_WS_URL=https://nexabitexchange.pro
VITE_APP_NAME=NexaBit

VITE_ENVIRONMENT=production



# External Services

VITE_QR_CODE_SERVICE=https://api.qrserver.com/v1/create-qr-code

VITE_BSC_EXPLORER=https://bscscan.com



# Static Deposit Address (TRC20 only - same for all users)

VITE_DEPOSIT_ADDRESS_TRC20=TL7v7Sb6gxTPyuCBhvoP2tcBYPq1k7KNbA





# Rate Limiting Configuration (should match backend .env)

VITE_RATE_LIMIT_ENABLED=true

VITE_CLIENT_THROTTLE_REQUESTS=20

VITE_CLIENT_THROTTLE_WINDOW=15000

VITE_REQUEST_SPACING=200

VITE_MAX_RETRY_ATTEMPTS=3

VITE_RETRY_DELAY=1000



# Cache Configuration

VITE_CACHE_TTL_SHORT=5000

VITE_CACHE_TTL_MEDIUM=30000

VITE_CACHE_TTL_LONG=60000



# WebSocket Configuration — tuned for 10k users (longer patience on reconnect)
VITE_WS_RECONNECT_INTERVAL=5000

VITE_WS_MAX_RECONNECT_ATTEMPTS=20

VITE_WS_HEARTBEAT_INTERVAL=30000



# Performance Configuration

VITE_ENABLE_PERFORMANCE_MONITORING=false

VITE_ENABLE_DEBUG_LOGGING=false

VITE_ENABLE_RATE_LIMIT_WARNINGS=false

VITE_DEBOUNCE_DELAY=300

VITE_API_REQUEST_TIMEOUT=30000


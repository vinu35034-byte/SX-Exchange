# Production Environment Variables
# Copy this file to .env and update the values for your production environment

# API Configuration
VITE_API_URL=https://nexabitexchange.pro/api/v1
VITE_API_BASE_URL=https://nexabitexchange.pro
VITE_WS_URL=https://nexabitexchange.pro
VITE_APP_NAME=NexaBit
VITE_ENVIRONMENT=production

# Static Deposit Address (TRC20 only - same for all users)
VITE_DEPOSIT_ADDRESS_TRC20=your_tron_wallet_address_here

# QR Code Service
VITE_QR_CODE_SERVICE=https://api.qrserver.com/v1/create-qr-code

# Security (only for development)
# In production, these should be set directly in your hosting environment
# VITE_ENABLE_DEBUG=false
# VITE_API_TIMEOUT=30000
